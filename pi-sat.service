[Unit]
Description=Pi-Sat Voice-Controlled Music Player
# User-level unit. Install: ~/.config/systemd/user/pi-sat.service
# Enable autostart at boot: requires `loginctl enable-linger dmitry`.
# Audio (PipeWire), MPD, and orchestrator all live in the same user manager,
# so XDG_RUNTIME_DIR / PULSE_SERVER are inherited and don't need to be set.
After=mpd.service sound.target
Wants=mpd.service

[Service]
Type=simple
WorkingDirectory=/home/dmitry/pi-sat
Environment="PYTHONUNBUFFERED=1"

# pi-sat.sh run ensures MPD is up before the orchestrator connects (defense in depth)
ExecStart=/home/dmitry/pi-sat/pi-sat.sh run

Restart=always
RestartSec=5

# Graceful shutdown (CTRL+C equivalent)
KillSignal=SIGINT
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-sat

[Install]
WantedBy=default.target
